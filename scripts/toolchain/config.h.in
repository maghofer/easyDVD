/* easyDVD's native Windows x64 configuration for dvdauthor 0.7.2.
 * PNG menu subpictures are supported. Text subtitle rendering is not used.
 * This file and the accompanying CMake recipe are distributed with the source.
 */
#define PACKAGE "dvdauthor"
#define PACKAGE_NAME "DVDAuthor"
#define PACKAGE_VERSION "0.7.2-easyDVD.1"
#define PACKAGE_STRING "DVDAuthor 0.7.2-easyDVD.1"
#define PACKAGE_BUGREPORT "https://github.com/maghofer/easyDVD/issues"
#define HAVE_STDBOOL_H 1
#define HAVE__BOOL 1
#define HAVE_STDLIB_H 1
#define HAVE_STDINT_H 1
#define HAVE_STRINGS_H 1
#define HAVE_STRING_H 1
#define HAVE_UNISTD_H 1
#define HAVE_INTTYPES_H 1
#define HAVE_MEMORY_H 1
#define HAVE_SYS_STAT_H 1
#define HAVE_SYS_TYPES_H 1
#define HAVE_GETOPT_H 1
#define HAVE_GETOPT_LONG 1
#define HAVE_IO_H 1
#define HAVE_SETMODE 1
#define HAVE_DECL_O_BINARY 1
#define HAVE_NESTED_ROUTINES 1
#cmakedefine HAVE_STRNDUP 1
#define SYSCONFDIR "."
